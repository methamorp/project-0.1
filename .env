# Sumber CertStream.
# Server demo publik CaliDog (certstream.calidog.io) sudah lama down/tidak stabil,
# jadi default-nya sekarang pakai instance self-hosted dari docker-compose.yml
# (service "certstream", image certstream-server-go). Jalankan `docker compose up -d`
# lalu pastikan URL di bawah ini tetap mengarah ke situ.
CERTSTREAM_URL=ws://localhost:8080/

REDIS_HOST=localhost
REDIS_PORT=6379

DATABASE_URL=postgresql://certwatch:certwatch@localhost:5432/certwatch

# User-Agent buat HTTP probe -- ganti dengan kontak asli kamu,
# ini penting secara etika supaya pemilik domain tahu siapa yang scan
HTTP_USER_AGENT=certwatch-research-bot/1.0 (+contact: musicprojeck910@)