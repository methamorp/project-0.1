# Sumber CertStream. Bisa ganti ke wss://certstream.dev/ (implementasi Rust, lebih stabil)
CERTSTREAM_URL=wss://certstream.calidog.io/

REDIS_HOST=localhost
REDIS_PORT=6379

DATABASE_URL=postgresql://certwatch:certwatch@localhost:5432/certwatch

# User-Agent buat HTTP probe -- ganti dengan kontak asli kamu,
# ini penting secara etika supaya pemilik domain tahu siapa yang scan
HTTP_USER_AGENT=certwatch-research-bot/1.0 (+contact: youremail@example.com)
